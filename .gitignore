# Local Python virtual environment
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Local test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter runtime files
.ipynb_checkpoints/

# macOS metadata
.DS_Store

# Local VS Code workspace settings
.vscode/
/tools/build-active-cpp.ps1

# C/C++ compiler output and debug symbols
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.d
*.dSYM/
*.i
*.ii
*.s
*.su
*.gcda
*.gcno
*.gcov

# CMake build output
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Compiled artifacts from .cpp sources.
# On macOS the compiler emits an extension-less executable beside its .cpp
# source (plus a .dSYM debug folder). Keep only the sources in this folder so
# every new build is ignored automatically.
/日常学习/*
!日常学习/*.cpp
